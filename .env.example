# Google OAuth (Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Auth.js: generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# Your deployed URL (use http://localhost:3000 locally)
NEXTAUTH_URL=https://your-app.vercel.app

# Only emails ending with @this-domain can sign in
ALLOWED_DOMAIN=yourcompany.com
# Comma-separated organizer emails
ORGANIZER_EMAILS=you@yourcompany.com

# Upstash Redis (added automatically if you use the Vercel Marketplace integration)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
